{
	"$schema": "../gen/schemas/mobile-schema.json",
	"identifier": "ios",
	"description": "iOS permissions without desktop updater or process restart",
	"platforms": ["iOS"],
	"windows": ["main"],
	"permissions": [
		"core:default",
		{
			"identifier": "opener:allow-open-url",
			"allow": [{ "url": "https://**" }, { "url": "http://**" }, { "url": "mailto:*" }]
		}
	]
}
